---
import { url, fmtDate, isoDate, TYPE_LABEL, type Post } from '../site';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((p) => (
    <li data-type={p.type} class:list={[{ 'has-thumb': !!p.thumb }]}>
      {p.thumb && (
        <a class="thumb" href={url(p.path)} tabindex="-1" aria-hidden="true">
          <img src={url(p.thumb)} alt="" loading="lazy" decoding="async" />
        </a>
      )}
      <div class="body">
      <div class="meta">
        <time datetime={isoDate(p.date)}>{fmtDate(p.date)}</time>
        <span class:list={['badge', p.type]}>{TYPE_LABEL[p.type]}</span>
        {p.tags.map((t) => <span class="tag">{t}</span>)}
        {p.mediaCount > 0 && <span>{p.mediaCount} media</span>}
      </div>
      <h2><a href={url(p.path)}>{p.title}</a></h2>
      {p.summary && <p>{p.summary}</p>}
      </div>
    </li>
  ))}
</ul>
