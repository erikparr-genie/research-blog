---
import { url } from '../site';
interface Item { src: string; kind: 'video' | 'image'; caption: string; poster?: string }
interface Props { items: Item[]; heading?: string }
const { items, heading = 'Media' } = Astro.props;
---
{items.length > 0 && (
  <section class="media" id="media">
    <h2>{heading}</h2>
    <div class="media-grid">
      {items.map((m) => (
        <figure class:list={[{ full: items.length === 1 }]}>
          {m.kind === 'video' ? (
            <video controls muted playsinline loop preload="metadata" poster={m.poster ? url(m.poster) : undefined}>
              <source src={url(m.src)} type="video/mp4" />
              <a href={url(m.src)}>Download the video</a>
            </video>
          ) : (
            <a href={url(m.src)}><img src={url(m.src)} alt={m.caption} loading="lazy" decoding="async" /></a>
          )}
          <figcaption>{m.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
